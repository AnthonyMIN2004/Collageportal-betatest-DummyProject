# ── KIRITAN PORTAL | SYSTEMD SERVICE (Raspberry Pi) ──
# Keeps the backend running 24/7 and restarts it after crashes/reboots.
#
# Install:  sudo cp deploy/kiritan-portal.service /etc/systemd/system/
#           sudo systemctl daemon-reload
#           sudo systemctl enable --now kiritan-portal
# Logs:     journalctl -u kiritan-portal -f

[Unit]
Description=Kiritan Collegiate Portal API (FastAPI)
After=network.target

[Service]
User=pi
WorkingDirectory=/home/pi/Collageportal-betatest-DummyProject/backend
# Set real secrets here (or use an EnvironmentFile)
Environment=PORTAL_SECRET=CHANGE-ME-TO-A-LONG-RANDOM-STRING
Environment=PORTAL_ADMIN_PW=CHANGE-ME-TOO
Environment=PORTAL_CORS=http://localhost,https://your-domain.example.com
ExecStart=/home/pi/Collageportal-betatest-DummyProject/backend/.venv/bin/uvicorn server:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
